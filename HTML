<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CPA Back-Office & Executive Tax Portal</title>
    <!-- Tailwind CSS for modern FinTech styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 antialiased selection:bg-indigo-500 selection:text-white">

    <div class="flex h-screen overflow-hidden">
        
        <!-- SIDEBAR -->
        <aside class="w-64 bg-slate-900 border-r border-slate-800 flex flex-col justify-between">
            <div>
                <!-- Brand Header -->
                <div class="p-6 border-b border-slate-800 flex items-center space-x-3">
                    <div class="h-9 w-9 bg-indigo-600 rounded-lg flex items-center justify-center font-bold text-white shadow-lg shadow-indigo-500/30">C</div>
                    <div>
                        <h1 class="text-sm font-semibold tracking-wide text-white">CPA Back-Office</h1>
                        <p class="text-xs text-slate-400">Enterprise Edition</p>
                    </div>
                </div>

                <!-- Navigation Menu -->
                <nav class="p-4 space-y-1">
                    <a href="#" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg bg-indigo-600/10 text-indigo-400 font-medium text-sm transition">
                        <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                        <span>Practice Dashboard</span>
                    </a>
                    <a href="#" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-slate-400 hover:bg-slate-800/50 hover:text-slate-200 text-sm transition">
                        <i data-lucide="folder-kanban" class="w-4 h-4"></i>
                        <span>Client Portals</span>
                    </a>
                    <a href="#" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-slate-400 hover:bg-slate-800/50 hover:text-slate-200 text-sm transition">
                        <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
                        <span>Tax Workpapers</span>
                    </a>
                    <a href="#" class="flex items-center space-x-3 px-4 py-2.5 rounded-lg text-slate-400 hover:bg-slate-800/50 hover:text-slate-200 text-sm transition">
                        <i data-lucide="alert-triangle" class="w-4 h-4"></i>
                        <span>Audit Exceptions <span class="ml-auto bg-rose-500/20 text-rose-400 text-xs px-2 py-0.5 rounded-full font-semibold">3</span></span>
                    </a>
                </nav>
            </div>

            <!-- User Footer -->
            <div class="p-4 border-t border-slate-800">
                <div class="flex items-center space-x-3 px-2 py-2">
                    <div class="h-8 w-8 rounded-full bg-slate-700 flex items-center justify-center font-semibold text-xs text-slate-300">MA</div>
                    <div class="overflow-hidden">
                        <p class="text-xs font-medium text-white truncate">Mahmoud J. Alramahi</p>
                        <p class="text-[10px] text-slate-400 truncate">Lead FP&A Architect</p>
                    </div>
                </div>
            </div>
        </aside>

        <!-- MAIN CONTENT AREA -->
        <main class="flex-1 flex flex-col overflow-y-auto bg-slate-950">
            
            <!-- Top Navbar -->
            <header class="h-16 border-b border-slate-800 bg-slate-900/50 backdrop-blur-md px-8 flex items-center justify-between sticky top-0 z-10">
                <div class="flex items-center space-x-4">
                    <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Active Period:</span>
                    <span class="text-xs font-medium bg-slate-800 text-slate-200 px-3 py-1 rounded-md border border-slate-700">October 2026 (Q3 Close)</span>
                </div>
                <div class="flex items-center space-x-4">
                    <button class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold px-4 py-2 rounded-lg shadow-md transition flex items-center space-x-2">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                        <span>Onboard New Client</span>
                    </button>
                </div>
            </header>

            <!-- Dashboard Content -->
            <div class="p-8 max-w-7xl mx-auto w-full space-y-8">
                
                <!-- Page Title -->
                <div class="flex justify-between items-end">
                    <div>
                        <h2 class="text-2xl font-bold tracking-tight text-white">CPA Practice Master Overview</h2>
                        <p class="text-sm text-slate-400 mt-1">Real-time automated reconciliation, tax prep status, and audit risk monitoring.</p>
                    </div>
                    <div class="flex space-x-3">
                        <button class="bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 text-xs font-medium px-4 py-2 rounded-lg transition flex items-center space-x-2">
                            <i data-lucide="download" class="w-3.5 h-3.5"></i>
                            <span>Export Packets</span>
                        </button>
                    </div>
                </div>

                <!-- KPI Metric Cards Grid -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
                    
                    <div class="bg-slate-900/80 border border-slate-800/80 p-5 rounded-xl shadow-sm">
                        <div class="flex justify-between items-start">
                            <p class="text-xs font-medium text-slate-400">Active Wholesale Clients</p>
                            <span class="text-emerald-400 bg-emerald-500/10 text-[10px] font-semibold px-2 py-0.5 rounded">+5 this month</span>
                        </div>
                        <h3 class="text-2xl font-bold text-white mt-2">42 <span class="text-xs font-normal text-slate-500">/ 100 Target</span></h3>
                        <div class="w-full bg-slate-800 h-1.5 rounded-full mt-4 overflow-hidden">
                            <div class="bg-indigo-500 h-full rounded-full" style="width: 42%"></div>
                        </div>
                    </div>

                    <div class="bg-slate-900/80 border border-slate-800/80 p-5 rounded-xl shadow-sm">
                        <div class="flex justify-between items-start">
                            <p class="text-xs font-medium text-slate-400">Monthly Recurring Revenue</p>
                            <span class="text-emerald-400 bg-emerald-500/10 text-[10px] font-semibold px-2 py-0.5 rounded">96% Margin</span>
                        </div>
                        <h3 class="text-2xl font-bold text-white mt-2">$5,250.00</h3>
                        <p class="text-[11px] text-slate-500 mt-3">Avg. $125/mo per account</p>
                    </div>

                    <div class="bg-slate-900/80 border border-slate-800/80 p-5 rounded-xl shadow-sm">
                        <div class="flex justify-between items-start">
                            <p class="text-xs font-medium text-slate-400">Pending Filing Deadlines</p>
                            <span class="text-amber-400 bg-amber-500/10 text-[10px] font-semibold px-2 py-0.5 rounded">Due Nov 1</span>
                        </div>
                        <h3 class="text-2xl font-bold text-white mt-2">8 Declarations</h3>
                        <p class="text-[11px] text-slate-500 mt-3">CT Town Personal Property</p>
                    </div>

                    <div class="bg-slate-900/80 border border-slate-800/80 p-5 rounded-xl shadow-sm">
                        <div class="flex justify-between items-start">
                            <p class="text-xs font-medium text-slate-400">Active Audit Exceptions</p>
                            <span class="text-rose-400 bg-rose-500/10 text-[10px] font-semibold px-2 py-0.5 rounded">Action Req.</span>
                        </div>
                        <h3 class="text-2xl font-bold text-white mt-2">3 Items</h3>
                        <p class="text-[11px] text-slate-500 mt-3">Missing W-9s & Commingling</p>
                    </div>

                </div>

                <!-- Client Portfolio Table Section -->
                <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-sm">
                    <div class="p-6 border-b border-slate-800 flex justify-between items-center">
                        <div>
                            <h3 class="text-base font-semibold text-white">Wholesale Client Portfolio Status</h3>
                            <p class="text-xs text-slate-400">Managed via automated QBO & Supabase ingestion pipelines.</p>
                        </div>
                        <div class="flex space-x-2">
                            <input type="text" placeholder="Search client..." class="bg-slate-950 border border-slate-800 text-xs px-3 py-1.5 rounded-lg text-slate-200 focus:outline-none focus:border-indigo-500">
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-slate-800 text-[11px] uppercase tracking-wider text-slate-400 bg-slate-900/50">
                                    <th class="py-3 px-6 font-semibold">Client Business Name</th>
                                    <th class="py-3 px-6 font-semibold">Entity Type</th>
                                    <th class="py-3 px-6 font-semibold">Last Reconciled</th>
                                    <th class="py-3 px-6 font-semibold">Pending Filing</th>
                                    <th class="py-3 px-6 font-semibold">System Status</th>
                                    <th class="py-3 px-6 text-right font-semibold">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800/60 text-xs">
                                <tr class="hover:bg-slate-800/30 transition">
                                    <td class="py-4 px-6 font-medium text-white flex items-center space-x-2">
                                        <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
                                        <span>Berlin Turnpike Mobil & Mart</span>
                                    </td>
                                    <td class="py-4 px-6 text-slate-300"><span class="bg-slate-800 px-2 py-0.5 rounded text-[11px]">1120-S</span></td>
                                    <td class="py-4 px-6 text-slate-400">Yesterday, 11:45 PM</td>
                                    <td class="py-4 px-6 text-slate-300 font-medium">CT Form OS-114 (Monthly)</td>
                                    <td class="py-4 px-6"><span class="bg-emerald-500/10 text-emerald-400 px-2.5 py-1 rounded-full font-medium text-[11px]">🟢 Ready to File</span></td>
                                    <td class="py-4 px-6 text-right"><button class="text-indigo-400 hover:text-indigo-300 font-medium">View Workpapers →</button></td>
                                </tr>
                                <tr class="hover:bg-slate-800/30 transition">
                                    <td class="py-4 px-6 font-medium text-white flex items-center space-x-2">
                                        <div class="w-2 h-2 rounded-full bg-amber-500"></div>
                                        <span>Newington Slice & Grill</span>
                                    </td>
                                    <td class="py-4 px-6 text-slate-300"><span class="bg-slate-800 px-2 py-0.5 rounded text-[11px]">1065</span></td>
                                    <td class="py-4 px-6 text-slate-400">2 days ago</td>
                                    <td class="py-4 px-6 text-slate-300 font-medium">Form 1065 & OS-114</td>
                                    <td class="py-4 px-6"><span class="bg-amber-500/10 text-amber-400 px-2.5 py-1 rounded-full font-medium text-[11px]">🟡 Missing Info</span></td>
                                    <td class="py-4 px-6 text-right"><button class="text-indigo-400 hover:text-indigo-300 font-medium">View Workpapers →</button></td>
                                </tr>
                                <tr class="hover:bg-slate-800/30 transition">
                                    <td class="py-4 px-6 font-medium text-white flex items-center space-x-2">
                                        <div class="w-2 h-2 rounded-full bg-rose-500"></div>
                                        <span>Rocky Hill Pro Plumbing LLC</span>
                                    </td>
                                    <td class="py-4 px-6 text-slate-300"><span class="bg-slate-800 px-2 py-0.5 rounded text-[11px]">1120-S</span></td>
                                    <td class="py-4 px-6 text-slate-400">Today, 8:15 AM</td>
                                    <td class="py-4 px-6 text-slate-300 font-medium">Form 1120-S / 1099</td>
                                    <td class="py-4 px-6"><span class="bg-rose-500/10 text-rose-400 px-2.5 py-1 rounded-full font-medium text-[11px]">🔴 Audit Flag</span></td>
                                    <td class="py-4 px-6 text-right"><button class="text-indigo-400 hover:text-indigo-300 font-medium">Resolve Flag →</button></td>
                                </tr>
                                <tr class="hover:bg-slate-800/30 transition">
                                    <td class="py-4 px-6 font-medium text-white flex items-center space-x-2">
                                        <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
                                        <span>CT Airport Rideshare Fleet</span>
                                    </td>
                                    <td class="py-4 px-6 text-slate-300"><span class="bg-slate-800 px-2 py-0.5 rounded text-[11px]">Schedule C</span></td>
                                    <td class="py-4 px-6 text-slate-400">3 days ago</td>
                                    <td class="py-4 px-6 text-slate-300 font-medium">Form 1040 (Sch C)</td>
                                    <td class="py-4 px-6"><span class="bg-emerald-500/10 text-emerald-400 px-2.5 py-1 rounded-full font-medium text-[11px]">🟢 Mileage Optimized</span></td>
                                    <td class="py-4 px-6 text-right"><button class="text-indigo-400 hover:text-indigo-300 font-medium">View Workpapers →</button></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- Initialize Lucide Icons -->
    <script>
        lucide.createIcons();
    </script>
</body>
</html>
